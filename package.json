{
  "name": "onchain-world-cup-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter @onchain-world-cup/app",
    "dev:landing": "turbo dev --filter @onchain-world-cup/landing",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.7.4"
  },
  "packageManager": "npm@10.9.2"
}
