# Crypto World Cup - Environment Variables Example
# Copy this file to .env.local and fill in your values

# ==============================================
# WalletConnect Configuration
# ==============================================
# Get your project ID from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ==============================================
# Base Network Configuration
# ==============================================
# Base Mainnet RPC URL (optional - uses public RPC if not set)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia Testnet RPC URL (optional - uses public RPC if not set)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ==============================================
# Smart Contract Addresses
# ==============================================
# Deploy contracts first, then add addresses here

# Match Factory Contract (deploys individual match contracts)
NEXT_PUBLIC_MATCH_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Match Registry Contract (stores all match data)
NEXT_PUBLIC_MATCH_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Platform wallet address (receives 10% fee)
NEXT_PUBLIC_PLATFORM_ADDRESS=0x0000000000000000000000000000000000000000

# ==============================================
# Farcaster Configuration
# ==============================================
# Your app's domain for Farcaster manifest
NEXT_PUBLIC_APP_DOMAIN=https://your-app-domain.vercel.app

# Farcaster app name
NEXT_PUBLIC_APP_NAME=Crypto World Cup 2026

# ==============================================
# Database Configuration (Supabase)
# ==============================================
# Supabase Project URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Anon Key (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (secret, never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================
# Analytics (Optional)
# ==============================================
# Vercel Analytics (automatically enabled on Vercel)
# No configuration needed

# ==============================================
# Development Settings
# ==============================================
# Set to 'development' or 'production'
NODE_ENV=development

# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# ==============================================
# Hardhat/Smart Contract Deployment
# ==============================================
# Private key for contract deployment (NEVER commit this!)
# Export from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here

# Basescan API key for contract verification
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# Base Mainnet RPC URL for deployment (optional)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Enable gas reporting in tests
REPORT_GAS=false
