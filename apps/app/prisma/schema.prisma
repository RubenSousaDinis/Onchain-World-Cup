generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CountryStats {
  countryCode String   @id @map("country_code")
  totalVotes  Int      @default(0) @map("total_votes")
  totalEth    String   @default("0") @map("total_eth")
  qualified   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([totalVotes])
  @@index([qualified])
  @@map("country_stats")
}

model QualificationVote {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  countryCode  String             @map("country_code")
  voterAddress String             @map("voter_address")
  voteCount    Int                @map("vote_count")
  totalCostEth String             @map("total_cost_eth")
  txHash       String             @unique @map("tx_hash")
  blockNumber  BigInt             @map("block_number")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction  IndexedTransaction @relation(fields: [txHash], references: [txHash], onDelete: Cascade)

  @@index([countryCode])
  @@index([voterAddress])
  @@index([createdAt])
  @@index([txHash])
  @@map("qualification_votes")
}

model UserStat {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletAddress         String    @unique @map("wallet_address")
  totalVotes            Int       @default(0) @map("total_votes")
  totalSpentEth         String    @default("0") @map("total_spent_eth")
  totalWonEth           String    @default("0") @map("total_won_eth")
  rank                  Int?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  countriesVotedFor     Int       @default(0) @map("countries_voted_for")
  qualificationSpentEth String    @default("0") @map("qualification_spent_eth")
  qualificationVotes    Int       @default(0) @map("qualification_votes")
  qualificationWonEth   String    @default("0") @map("qualification_won_eth")
  ensName               String?   @map("ens_name")
  userId                String?   @unique @map("user_id") @db.Uuid
  referralEarnedEth     String    @default("0") @map("referral_earned_eth")
  referralCount         Int       @default(0) @map("referral_count")
  user                  User?     @relation(fields: [userId], references: [id])

  @@index([walletAddress])
  @@index([rank])
  @@index([qualificationVotes])
  @@map("user_stats")
}

model FarcasterNotificationToken {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fid             Int
  walletAddress   String?   @map("wallet_address")
  notificationUrl String    @map("notification_url")
  token           String
  enabled         Boolean   @default(true)
  miniappAddedAt  DateTime  @map("miniapp_added_at") @db.Timestamptz(6)
  lastNotifiedAt  DateTime? @map("last_notified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fid, token])
  @@index([fid])
  @@index([enabled])
  @@map("farcaster_notification_tokens")
}

model IndexerState {
  chainId          Int      @id @map("chain_id")
  lastIndexedBlock BigInt   @map("last_indexed_block")
  lastIndexedAt    DateTime @map("last_indexed_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("indexer_state")
}

model IndexedTransaction {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  txHash          String             @unique @map("tx_hash")
  contractAddress String             @map("contract_address")
  walletAddress   String             @map("wallet_address")
  chainId         Int                @map("chain_id")
  syncType        String             @map("sync_type")
  status          String
  blockNumber     BigInt?            @map("block_number")
  eventType       String             @map("event_type")
  metadata        Json?
  indexedAt       DateTime           @default(now()) @map("indexed_at") @db.Timestamptz(6)
  confirmedAt     DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  errorMessage    String?            @map("error_message")
  vote            QualificationVote?

  @@index([txHash])
  @@index([walletAddress])
  @@index([syncType])
  @@index([status])
  @@index([chainId])
  @@index([contractAddress])
  @@map("indexed_transactions")
}

model User {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletAddress String    @unique @map("wallet_address")
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts      Account[]
  sessions      Session[]
  stats         UserStat?

  @@index([walletAddress])
  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Tournament {
  id             String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String
  year           Int
  hostCountries  String[]          @map("host_countries")
  totalTeams     Int               @map("total_teams")
  startDate      DateTime          @map("start_date") @db.Timestamptz(6)
  endDate        DateTime          @map("end_date") @db.Timestamptz(6)
  status         String
  currentPhase   String?           @map("current_phase")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  phases         TournamentPhase[]
  groups         Group[]

  @@map("tournaments")
}

model TournamentPhase {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tournamentId String     @map("tournament_id") @db.Uuid
  name         String
  displayName  String     @map("display_name")
  phaseOrder   Int        @map("phase_order")
  startDate    DateTime?  @map("start_date") @db.Timestamptz(6)
  endDate      DateTime?  @map("end_date") @db.Timestamptz(6)
  status       String
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([status])
  @@map("tournament_phases")
}

model Group {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tournamentId   String           @map("tournament_id") @db.Uuid
  name           String
  displayName    String           @map("display_name")
  maxTeams       Int              @map("max_teams")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tournament     Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  standings      GroupStanding[]
  lastCalculated DateTime?        @map("last_calculated") @db.Timestamptz(6)

  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@map("groups")
}

model GroupStanding {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  countryCode    String   @map("country_code")
  qualRank       Int      @map("qual_rank")
  position       Int?
  matchesPlayed  Int      @default(0) @map("matches_played")
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  votesFor       Int      @default(0) @map("votes_for")
  votesAgainst   Int      @default(0) @map("votes_against")
  voteDifference Int      @default(0) @map("vote_difference")
  points         Int      @default(0)
  qualified      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, countryCode])
  @@index([groupId])
  @@index([countryCode])
  @@index([qualRank])
  @@map("group_standings")
}

model Referral {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  referrerAddress   String   @map("referrer_address")
  referredAddress   String   @map("referred_address")
  txHash            String   @unique @map("tx_hash")
  voteAmountEth     String   @map("vote_amount_eth")
  referralAmountEth String   @map("referral_amount_eth")
  contractAddress   String   @map("contract_address")
  contractType      String   @map("contract_type")
  blockNumber       BigInt?  @map("block_number")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([referrerAddress])
  @@index([referredAddress])
  @@map("referrals")
}

model ContentPost {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type              String    // "blog" | "twitter_thread"
  title             String
  content           String    @db.Text
  status            String    @default("draft") // "draft" | "published" | "archived"
  topic             String?
  aiGenerated       Boolean   @default(false) @map("ai_generated")
  prompt            String?   @db.Text
  metadata          Json?     // thread tweets array, SEO data, estimated reach, etc.
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  scheduledAt       DateTime? @map("scheduled_at") @db.Timestamptz(6)
  performanceRating String?   @map("performance_rating") // "good" | "neutral" | "poor"
  performanceNotes  String?   @map("performance_notes") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([performanceRating])
  @@map("content_posts")
}
