// Prisma Schema for Onchain World Cup
// Simplified schema for qualification phase only
// Database: PostgreSQL (via Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Aggregated voting statistics per country (static country data comes from lib/countries.ts)
model CountryStats {
  countryCode  String   @id @map("country_code") // Two-letter country code (e.g., "BR", "AR")
  totalVotes   Int      @default(0) @map("total_votes") // Total votes received
  totalEth     String   @default("0") @map("total_eth") // Total ETH backing this country
  qualified    Boolean  @default(false) // Whether country qualified (top 48)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([totalVotes])
  @@index([qualified])
  @@map("country_stats")
}

// Individual votes placed by users for countries to qualify
model QualificationVote {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  countryCode  String   @map("country_code") // Two-letter country code
  voterAddress String   @map("voter_address")
  voteCount    Int      @map("vote_count") // Number of votes purchased
  totalCostEth String   @map("total_cost_eth") // ETH spent on these votes
  txHash       String   @unique @map("tx_hash")
  blockNumber  BigInt   @map("block_number")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([countryCode])
  @@index([voterAddress])
  @@index([createdAt])
  @@map("qualification_votes")
}

// User statistics and rankings
model UserStat {
  id                       String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletAddress            String    @unique @map("wallet_address")

  // Qualification phase stats
  qualificationVotes       Int       @default(0) @map("qualification_votes") // Total votes placed in qualification
  qualificationSpentEth    String    @default("0") @map("qualification_spent_eth") // ETH spent in qualification
  qualificationWonEth      String    @default("0") @map("qualification_won_eth") // ETH won from qualification
  countriesVotedFor        Int       @default(0) @map("countries_voted_for") // Number of different countries voted for

  // Overall stats (will be used for future tournament phases)
  totalVotes               Int       @default(0) @map("total_votes")
  totalSpentEth            String    @default("0") @map("total_spent_eth")
  totalWonEth              String    @default("0") @map("total_won_eth")

  rank                     Int?
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([walletAddress])
  @@index([rank])
  @@index([qualificationVotes])
  @@map("user_stats")
}

// Farcaster notification tokens for Mini App users
model FarcasterNotificationToken {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fid              Int       // Farcaster ID
  walletAddress    String?   @map("wallet_address") // Optional wallet address if linked
  notificationUrl  String    @map("notification_url") // URL to POST notifications
  token            String    // Authentication token
  enabled          Boolean   @default(true) // Whether notifications are enabled
  miniappAddedAt   DateTime  @map("miniapp_added_at") @db.Timestamptz(6) // When user added the Mini App
  lastNotifiedAt   DateTime? @map("last_notified_at") @db.Timestamptz(6) // Last notification sent
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fid, token]) // Each FID can have multiple tokens from different clients
  @@index([fid])
  @@index([enabled])
  @@map("farcaster_notification_tokens")
}

// Indexer state tracking for blockchain event synchronization
model IndexerState {
  chainId          Int      @id @map("chain_id") // 84532 (Base Sepolia) or 8453 (Base Mainnet)
  lastIndexedBlock BigInt   @map("last_indexed_block") // Last block number indexed
  lastIndexedAt    DateTime @map("last_indexed_at") @db.Timestamptz(6) // Timestamp of last indexing
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("indexer_state")
}
