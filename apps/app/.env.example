# =============================================================================
# ENVIRONMENT VARIABLES - Onchain World Cup App
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
#
# Required variables are marked with (REQUIRED)
# Optional variables are marked with (OPTIONAL)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL
# Format: https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Service role key with full database access
# ⚠️  CRITICAL: Never expose this key to the client! Only use in API routes.
# This key bypasses Row Level Security (RLS) policies
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Web3 Configuration (REQUIRED for Web3 features)
# -----------------------------------------------------------------------------
# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base Network RPC URLs
# Default: Public RPC endpoints (may have rate limits)
# For production, consider using Alchemy, Infura, or QuickNode
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# -----------------------------------------------------------------------------
# Smart Contract Deployment (REQUIRED for deployment only)
# -----------------------------------------------------------------------------
# Private key for deploying contracts
# ⚠️  CRITICAL: Never commit this! Only use for deployment scripts.
# Format: 0x... (without 0x prefix in some tools)
PRIVATE_KEY=

# BaseScan API Key for contract verification
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=

# Enable gas reporting in Hardhat tests
# Options: "true" or "false"
REPORT_GAS=false

# -----------------------------------------------------------------------------
# Application Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# API base URL (defaults to /api if not set)
# NEXT_PUBLIC_API_URL=/api

# Application domain for metadata and Farcaster integration
# Format: https://your-domain.com (no trailing slash)
# NEXT_PUBLIC_APP_DOMAIN=https://your-domain.vercel.app

# Enable debug logging for development
# Options: "true" or "false"
# NEXT_PUBLIC_DEBUG=false

# Enable API documentation page in production
# Options: "true" or "false"
# NEXT_PUBLIC_ENABLE_API_DOCS=false

# -----------------------------------------------------------------------------
# Development Environment
# -----------------------------------------------------------------------------
# Automatically set by Next.js, but can be overridden
# Options: development, production, test
# NODE_ENV=development
