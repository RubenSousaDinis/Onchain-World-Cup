# =============================================================================
# ENVIRONMENT VARIABLES - Onchain World Cup App
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
#
# Required variables are marked with (REQUIRED)
# Optional variables are marked with (OPTIONAL)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL
# Format: https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Service role key with full database access
# ⚠️  CRITICAL: Never expose this key to the client! Only use in API routes.
# This key bypasses Row Level Security (RLS) policies
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Prisma / Database Configuration (REQUIRED for Prisma ORM)
# -----------------------------------------------------------------------------
# DATABASE_URL: Connection string for Prisma (uses connection pooler)
# Get from: https://app.supabase.com/project/_/settings/database
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# DIRECT_URL: Direct connection for migrations (bypasses connection pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=

# -----------------------------------------------------------------------------
# Web3 Configuration (REQUIRED for Web3 features)
# -----------------------------------------------------------------------------
# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base Network RPC URLs
# Default: Public RPC endpoints (may have rate limits)
# For production, consider using Alchemy, Infura, or QuickNode
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# -----------------------------------------------------------------------------
# Smart Contract Deployment (REQUIRED for deployment only)
# -----------------------------------------------------------------------------
# Private key for deploying contracts
# ⚠️  CRITICAL: Never commit this! Only use for deployment scripts.
# Format: 0x... (without 0x prefix in some tools)
PRIVATE_KEY=

# BaseScan API Key for contract verification
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=

# Enable gas reporting in Hardhat tests
# Options: "true" or "false"
REPORT_GAS=false

# -----------------------------------------------------------------------------
# Smart Contract Addresses (REQUIRED for frontend)
# -----------------------------------------------------------------------------
# WorldCupQualification Contract Addresses
# Base Sepolia (testnet)
NEXT_PUBLIC_QUALIFICATION_CONTRACT_SEPOLIA=0x5b202Aec41D1C85f294267D2A42Eac8865AAcCE9

# Base Mainnet (production)
# NEXT_PUBLIC_QUALIFICATION_CONTRACT_MAINNET=

# -----------------------------------------------------------------------------
# Application Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# API base URL (defaults to /api if not set)
# NEXT_PUBLIC_API_URL=/api

# Application domain for metadata and Farcaster integration
# Format: https://your-domain.com (no trailing slash)
# NEXT_PUBLIC_APP_DOMAIN=https://your-domain.vercel.app

# Enable debug logging for development
# Options: "true" or "false"
# NEXT_PUBLIC_DEBUG=false

# Enable API documentation page in production
# Options: "true" or "false"
# NEXT_PUBLIC_ENABLE_API_DOCS=false

# -----------------------------------------------------------------------------
# Next-Auth Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# NEXTAUTH_SECRET: Secret key for JWT signing and encryption
# Generate with: openssl rand -base64 32
# ⚠️  CRITICAL: Keep this secret! Never commit to version control!
NEXTAUTH_SECRET=

# NEXTAUTH_URL: Your application URL (required for authentication to work)
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app (NO trailing slash!)
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# API Security (REQUIRED for production)
# -----------------------------------------------------------------------------
# API secret keys for protected endpoints (comma-separated for multiple keys)
# Generate secure keys with: openssl rand -hex 32
# Example: API_SECRET_KEYS=abc123...,def456...
# These keys are required for:
# - POST /api/indexer/sync (manual blockchain event syncing - admin only)
# - Any other admin/write operations
# ⚠️  CRITICAL: Keep these secret! Never commit to version control!
# ⚠️  NEVER expose these to the frontend/browser!
# ⚠️  In development (localhost), authentication is bypassed
# API_SECRET_KEYS=

# Cron job secret for automatic indexer syncing
# Generate with: openssl rand -hex 32
# Used by Vercel Cron to authenticate scheduled sync jobs
# This is SAFE because cron jobs run server-side, never in browser
# CRON_SECRET=

# Chain ID for automatic indexer syncing via cron
# 84532 = Base Sepolia (testnet)
# 8453 = Base Mainnet (production)
# INDEXER_CHAIN_ID=84532

# -----------------------------------------------------------------------------
# Development Environment
# -----------------------------------------------------------------------------
# Automatically set by Next.js, but can be overridden
# Options: development, production, test
# NODE_ENV=development
